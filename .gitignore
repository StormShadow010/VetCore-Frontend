# ============================================================
# .gitignore — React + TypeScript (Vite)
# ============================================================

# ─── Dependencias ───────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Build / Dist ────────────────────────────────────────────
dist/
dist-ssr/
build/
out/

# ─── Variables de entorno ────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ─── Caché y herramientas ────────────────────────────────────
.vite/
.eslintcache
.tsbuildinfo
*.tsbuildinfo

# ─── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Testing ─────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── IDEs y editores ─────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Sistema operativo ───────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Misc ────────────────────────────────────────────────────
*.local